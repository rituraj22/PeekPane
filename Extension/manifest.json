{
  "manifest_version": 3,
  "name": "PeekPane — Float Browser Tab Region",
  "version": "1.1",
  "description": "Float any region or full viewport of a browser tab in PeekPane without toolbars, even while switching tabs or minimizing.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabCapture",
    "activeTab",
    "scripting",
    "offscreen",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Float Tab Region in PeekPane (⌥⇧P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Select a browser tab region to float in PeekPane"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
